<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sp.app.admin.mapper.AdminPaymentMapper">

    <sql id="where-list">
        <if test="schType == 'all'">
            (INSTR(p.userId, #{kwd}) &gt; 0 OR INSTR(p.orderId, #{kwd}) &gt; 0)
        </if>
        <if test="schType == 'userId'">
            INSTR(p.userId, #{kwd}) &gt; 0
        </if>
        <if test="schType == 'orderId'">
            INSTR(p.orderId, #{kwd}) &gt; 0
        </if>
    </sql>

    <select id="dataCount" parameterType="map" resultType="Integer">
        SELECT NVL(COUNT(*), 0)
        FROM payment p
        JOIN member1 m ON p.userId = m.userId
        <where>
            <if test="kwd != null and kwd != ''">
                <include refid="where-list"/>
            </if>
            <if test="status != null and status != ''">
                AND p.status = #{status}
            </if>
        </where>
    </select>

    <select id="listPayment" parameterType="map" resultType="map">
        SELECT p.orderId, p.userId, m.nickname, p.payType, p.amount, 
               TO_CHAR(p.payDate, 'YYYY-MM-DD HH24:MI') as payDate, p.status
        FROM payment p
        JOIN member1 m ON p.userId = m.userId
        <where>
            <if test="kwd != null and kwd != ''">
                <include refid="where-list"/>
            </if>
            <if test="status != null and status != ''">
                AND p.status = #{status}
            </if>
        </where>
        ORDER BY p.payDate DESC
        OFFSET #{offset} ROWS FETCH NEXT #{pageSize} ROWS ONLY
    </select>
</mapper>