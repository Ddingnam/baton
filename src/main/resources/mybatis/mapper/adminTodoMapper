<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sp.app.admin.mapper.AdminTodoMapper">

    <select id="getTodoList" resultType="com.sp.app.admin.model.AdminTodo">
        SELECT todoIdx, adminIdx, content, isDone, sortOrder,
               TO_CHAR(createdAt, 'YYYY-MM-DD HH24:MI') AS createdAt
        FROM ADMIN_TODO
        WHERE adminIdx = #{adminIdx}
        ORDER BY isDone ASC, sortOrder ASC, todoIdx DESC
    </select>

    <insert id="insertTodo" parameterType="com.sp.app.admin.model.AdminTodo">
        INSERT INTO ADMIN_TODO (todoIdx, adminIdx, content, isDone, sortOrder, createdAt, updatedAt)
        VALUES (
            admin_todo_seq.NEXTVAL,
            #{adminIdx},
            #{content},
            0,
            NVL((SELECT MAX(sortOrder) + 1 FROM ADMIN_TODO WHERE adminIdx = #{adminIdx}), 0),
            SYSTIMESTAMP,
            SYSTIMESTAMP
        )
    </insert>

    <update id="updateTodoDone">
        UPDATE ADMIN_TODO
        SET isDone = #{isDone}, updatedAt = SYSTIMESTAMP
        WHERE todoIdx = #{todoIdx} AND adminIdx = #{adminIdx}
    </update>

    <update id="updateTodoContent">
        UPDATE ADMIN_TODO
        SET content = #{content}, updatedAt = SYSTIMESTAMP
        WHERE todoIdx = #{todoIdx} AND adminIdx = #{adminIdx}
    </update>

    <delete id="deleteTodo">
        DELETE FROM ADMIN_TODO
        WHERE todoIdx = #{todoIdx} AND adminIdx = #{adminIdx}
    </delete>

    <delete id="deleteDoneTodos">
        DELETE FROM ADMIN_TODO
        WHERE adminIdx = #{adminIdx} AND isDone = 1
    </delete>

</mapper>